{
  "name": "mountable-sdk",
  "version": "0.0.0-dev",
  "description": "Read, write, list and follow files in a Mountable filesystem over HTTPS.",
  "keywords": [
    "sdk",
    "ai-agents",
    "agent-sandbox",
    "filesystem",
    "file-storage",
    "change-feed"
  ],
  "homepage": "https://mountable.io/docs",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/contract.test.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writeitai/mountable.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/writeitai/mountable/issues"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
